# 复制到 /etc/systemd/system/onlinecompress.service 后:
#   sudo systemctl daemon-reload && sudo systemctl enable --now onlinecompress
# 请把 User / WorkingDirectory / ExecStart 中的路径改成实际值。
[Unit]
Description=onlinecompress video compression service
After=network.target

[Service]
Type=simple
User=youruser
WorkingDirectory=/opt/onlinecompress
ExecStart=/usr/bin/node /opt/onlinecompress/server.js
Restart=on-failure
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
